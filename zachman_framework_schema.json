{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zachman Framework Schema",
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "description": "What - The data or inventory being handled",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "description": "How - The process or function being performed",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "description": "When - The time or schedule",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "entities",
    "capabilities",
    "events"
  ],
  "additionalProperties": false
}
